# ============================================================================
# Direct Provider API Keys
# ============================================================================
# Tested with Mistral Small 3.1. A bigger model will produce better results, obviously
# These keys are used when LLM_* variables use direct provider model strings
# (e.g., mistral/mistral-small-latest, openai/gpt-4, etc.)
# The key follows the model: a role with no key of its own uses the key of the role
# its model came from (LITELLM_API_KEY_AGENT for a role that falls back to LLM_AGENT),
# or the base role's key when both models name the same provider. With one provider,
# LITELLM_API_KEY_AGENT alone is enough (LITELLM_API_KEY_PLANNER without an agent model).
LITELLM_API_KEY_SYNDATA_GEN=<API KEY for synthetic data generation model>
LITELLM_API_KEY_PARAM_EXTRACTION=<API KEY for parameter extraction model>
LITELLM_API_KEY_PLANNER=<API KEY for the agent's task planner model>
LITELLM_API_KEY_AGENT=<API KEY for the agent model>
LITELLM_API_KEY_CONVERSATION_STORE=<API KEY for conversation topic/summary generation model>

# ============================================================================
# LiteLLM Proxy API Key (Optional)
# ============================================================================
# When using litellm_proxy/ model strings, this shared key is used for all
# proxied calls. The per-role keys above are ignored for proxied models.
# Leave commented if your proxy doesn't require authentication.
# LITELLM_PROXY_API_KEY=<API KEY for LiteLLM Proxy authentication>
# API key for LLM_OBSERVATION_SEARCH (proxy/ambient credentials also supported).
LITELLM_API_KEY_OBSERVATION_SEARCH=

# ============================================================================
# Jev (TypeSafe) API Key
# ============================================================================
# The remote decision model: it decides the command when the local intent model is
# not confident, matches a request to a planning command, and gates request splitting.
# It sends the request and the commands' descriptions to TypeSafe.
# REQUIRED without an agent model (LLM_AGENT unset); optional otherwise: without it,
# an unsure local model asks the user or the agent instead.
# JEV_API_KEY=

# API key for LLM_POLICY_INTENT (policy verifiers), when that model is set.
# LITELLM_API_KEY_POLICY_INTENT=<API KEY for the policy model>
